<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadatos del widget del avatar.
  minWidth/minHeight de 60dp: es el tamaño de una celda en la pantalla de
  widgets de un reloj redondo pequeño.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="60dp"
    android:minHeight="60dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/avatar_widget"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_avatar_descripcion" />
